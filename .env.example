# ─────────────────────────────────────────────────────────────────────────────
# AssessIQ — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_32_CHARS_MIN
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assessiq
POSTGRES_USER=assessiq_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ── Object Storage (S3-compatible) ────────────────────────────────────────────
STORAGE_PROVIDER=local          # local | s3 | gcs
STORAGE_LOCAL_PATH=/app/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console          # console | smtp | sendgrid | resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@assessiq.io

# ── First Super Admin (created on startup if DB is fresh) ─────────────────────
SUPER_ADMIN_EMAIL=admin@assessiq.io
SUPER_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_PASSWORD

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_AI_COPILOT=false
FEATURE_PROCTORING=false
FEATURE_CODING_RUNNER=false
